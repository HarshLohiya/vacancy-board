# Copy this file to .env and fill in the two Telegram values.
# .env is gitignored - it never leaves this machine.
# The cloud run ignores this file and uses GitHub Secrets instead.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Adds the "open the dashboard" link to the message.
DASHBOARD_URL=https://harshlohiya.github.io/vacancy-board/

# Optional. Send a message even when nothing has changed.
# ALWAYS_NOTIFY=true

# E-mail and WhatsApp are skipped in v1. Filling these in is all that is
# needed to switch them on - no code change.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_TO=
